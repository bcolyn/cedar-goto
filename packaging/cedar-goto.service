[Unit]
Description=cedar-goto - ASCOM Alpaca bridge facilitating cedar-server with a GoTo mount
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cedar-goto
WorkingDirectory=/opt/cedar-goto
ExecStart=/opt/cedar-goto/.venv/bin/python -m cedar_goto --config /opt/cedar-goto/config.toml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
